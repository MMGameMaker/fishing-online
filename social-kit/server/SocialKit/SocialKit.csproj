<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SocialKit (server): đăng nhập Google/Facebook qua Firebase (xác minh ID token), avatar tài khoản, chia sẻ, nhóm Facebook và thống kê.
    Không tham chiếu code game: dự án khác chỉ cần ProjectReference tới file này rồi gọi AddSocialKit/MapSocialKit (xem ../../README.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RootNamespace>SocialKit</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
  </ItemGroup>
</Project>

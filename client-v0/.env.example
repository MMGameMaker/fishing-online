# Sao chép thành .env nếu cần đổi mặc định. Không commit .env thật.
# Gốc Server, không có /api/v1 ở cuối.
VITE_API_BASE=http://localhost:5080
# true: dùng MockBackend trong trình duyệt. false: gọi Server thật.
# Mặc định khi không đặt: dev = true, build = false.
VITE_USE_MOCK=true

# Dùng cho app index.html (src/main.js) — đăng nhập Google qua Firebase.
# Firebase Web config (không phải secret) — lấy ở Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

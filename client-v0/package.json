{
  "name": "pixadom-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cozy 2D social pixel-art prototype: character customization, chat, direct messages and fishing.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-force-exit test/server.test.js",
    "typecheck": "tsc --noEmit",
    "test:online": "vitest run",
    "lint:online": "eslint src/online && prettier --check \"src/online/**/*.{ts,css}\""
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "express": "^4.19.2",
    "firebase": "^11.10.0",
    "jose": "^6.2.17",
    "phaser": "3.90.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "^8.2.2",
    "eslint": "9.39.5",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^5.4.0",
    "vitest": "3.2.7"
  }
}

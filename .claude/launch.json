{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "admin",
        "run",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "client-v0",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client-v0",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "client-v0-real",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_USE_MOCK=false&& npm --prefix client-v0 run dev"
      ],
      "port": 5173
    },
    {
      "name": "client-v0-mock",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd client-v0&& set VITE_USE_MOCK=true&& npx vite --port 5175 --strictPort"
      ],
      "port": 5175
    }
  ]
}

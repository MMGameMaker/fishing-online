<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Bản không kèm Microsoft.Testing.Platform, để lệnh chuẩn `dotnet test server` (QUY_TRINH mục 5) chạy qua VSTest. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FishingOnline.Domain/FishingOnline.Domain.csproj" />
    <ProjectReference Include="../FishingOnline.Sim/FishingOnline.Sim.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../docs/v01/fixtures/gameplay-config.v0.json" Link="fixtures/gameplay-config.v0.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/v01/fixtures/minigame-vectors.v0.json" Link="fixtures/minigame-vectors.v0.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../client-v0/src/online/fishing/minigame-vectors.v0.json" Link="fixtures/client-minigame-vectors.v0.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

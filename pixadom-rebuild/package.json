{
  "name": "pixadom-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cozy 2D social pixel-art prototype: character customization, chat, direct messages and fishing.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-force-exit test/server.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "phaser": "^3.80.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pngjs": "^7.0.0",
    "vite": "^5.4.0"
  }
}
